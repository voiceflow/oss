{
  "$schema": "https://turborepo.dev/schema.v2.json",
  "envMode": "loose",
  "tasks": {
    "build:cmd": {
      "outputs": ["build/**"],
      "inputs": ["src/**", ":!src/**/*.test.ts", "package.json", "tsconfig.json", "tsdown.config.ts"],
      "dependsOn": ["^build:cmd"]
    },
    "test:types": {
      "inputs": ["src/**", "package.json", "tsconfig.json"],
      "dependsOn": ["^build:cmd"]
    },
    "test:cycles": {
      "inputs": ["src/**", "package.json", "tsconfig.json"]
    },
    "clean": {
      "cache": false
    },
    "//#test:unused": {
      "cache": false
    },
    "//#test:unit": {
      "cache": false
    }
  }
}
