{
  "name": "@voiceflow/normal-store",
  "version": "4.0.0",
  "description": "tools for interacting with normalized data structures",
  "keywords": [
    "data",
    "voiceflow"
  ],
  "homepage": "https://github.com/voiceflow/oss/tree/master/libs/normal-store#readme",
  "bugs": {
    "url": "https://github.com/voiceflow/oss/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/voiceflow/oss.git"
  },
  "license": "ISC",
  "author": "Tyler Han, Ben Teichman",
  "type": "module",
  "exports": {
    ".": "./build/index.mjs"
  },
  "files": [
    "build"
  ],
  "scripts": {
    "build": "yarn g:turbo run build:cmd --filter=@voiceflow/normal-store...",
    "build:cmd": "yarn g:tsdown",
    "clean": "yarn g:rimraf build",
    "lint": "yarn g:run-p -c lint:eslint lint:prettier",
    "lint:eslint": "yarn g:eslint",
    "lint:fix": "yarn g:run-p -c \"lint:eslint --fix\" \"lint:prettier --write\"",
    "lint:prettier": "yarn g:prettier --check",
    "tdd": "yarn g:vitest",
    "test": "yarn g:run-p -c test:types test:unit test:cycles test:unused",
    "test:cycles": "yarn g:dpdm src/index.ts",
    "test:types": "yarn g:tsc --noEmit",
    "test:unit": "yarn g:vitest run --coverage",
    "test:unused": "yarn g:knip --workspace @voiceflow/normal-store"
  },
  "engines": {
    "node": "26"
  },
  "volta": {
    "extends": "../../package.json"
  }
}
