{
  "name": "@voiceflow/nestjs-chargebee",
  "version": "4.1.0",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/voiceflow/oss.git"
  },
  "files": [
    "build"
  ],
  "type": "module",
  "exports": {
    ".": "./build/index.mjs",
    "./models": "./build/models.mjs"
  },
  "scripts": {
    "build": "yarn g:turbo run build:cmd --filter=@voiceflow/nestjs-chargebee...",
    "build:cmd": "yarn g:tsdown",
    "clean": "yarn g:rimraf build",
    "lint": "yarn g:run-p -c lint:oxlint lint:oxfmt",
    "lint:fix": "yarn g:run-p -c \"g:oxlint . --fix\" \"g:oxfmt .\"",
    "lint:oxfmt": "yarn g:oxfmt --check .",
    "lint:oxlint": "yarn g:oxlint .",
    "test": "yarn g:run-p -c test:types test:cycles test:unused",
    "test:cycles": "yarn g:dpdm src/main.ts",
    "test:types": "yarn g:tsc --noEmit",
    "test:unused": "yarn g:knip --workspace @voiceflow/nestjs-chargebee"
  },
  "dependencies": {
    "chargebee": "3.26.0"
  },
  "devDependencies": {
    "@nestjs/common": "10.4.16",
    "@nestjs/core": "10.1.3",
    "rxjs": "7.8.1"
  },
  "peerDependencies": {
    "@nestjs/common": "^10",
    "rxjs": "^7"
  },
  "engines": {
    "node": "26"
  },
  "volta": {
    "extends": "../../package.json"
  }
}
