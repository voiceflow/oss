{
  "name": "@voiceflow/composite-reducer",
  "version": "4.0.0",
  "description": "combine reducers based on individual properties",
  "keywords": [
    "combinedReducer",
    "react",
    "react-redux",
    "reducer",
    "redux",
    "voiceflow"
  ],
  "homepage": "https://github.com/voiceflow/oss/tree/master/libs/composite-reducer#readme",
  "bugs": {
    "url": "https://github.com/voiceflow/oss/issues"
  },
  "license": "ISC",
  "author": "Tyler Han, Ben Teichman",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/voiceflow/oss.git"
  },
  "files": [
    "build"
  ],
  "type": "module",
  "exports": {
    ".": "./build/index.mjs"
  },
  "scripts": {
    "build": "yarn g:turbo run build:cmd --filter=@voiceflow/composite-reducer...",
    "build:cmd": "yarn g:tsdown",
    "clean": "yarn g:rimraf build",
    "lint": "yarn g:run-p -c lint:oxlint lint:oxfmt",
    "lint:fix": "yarn g:run-p -c \"g:oxlint . --fix\" \"g:oxfmt .\"",
    "lint:oxfmt": "yarn g:oxfmt --check .",
    "lint:oxlint": "yarn g:oxlint .",
    "test": "yarn g:run-p -c test:types test:cycles test:unused",
    "test:cycles": "yarn g:dpdm src/index.ts",
    "test:types": "yarn g:tsc --noEmit",
    "test:unused": "yarn g:knip --workspace @voiceflow/composite-reducer"
  },
  "engines": {
    "node": "26"
  },
  "volta": {
    "extends": "../../package.json"
  }
}
