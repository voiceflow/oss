{
  "name": "@voiceflow/universal-mock",
  "version": "2.0.0",
  "type": "module",
  "exports": {
    ".": "./build/main.mjs",
    "./vitest": "./vitest/main.mjs"
  },
  "files": [
    "build",
    "vitest"
  ],
  "scripts": {
    "build": "yarn g:turbo run build:cmd --filter=@voiceflow/universal-mock...",
    "build:cmd": "yarn g:tsdown",
    "clean": "yarn g:rimraf build",
    "lint": "yarn g:run-p -c lint:eslint lint:prettier",
    "lint:eslint": "yarn g:eslint",
    "lint:fix": "yarn g:run-p -c \"lint:eslint --fix\" \"lint:prettier --write\"",
    "lint:prettier": "yarn g:prettier --check",
    "tdd": "yarn g:vitest",
    "test": "yarn g:run-p -c test:types test:unit test:cycles test:unused",
    "test:cycles": "yarn g:dpdm src/main.ts",
    "test:types": "yarn g:tsc --noEmit",
    "test:unit": "yarn g:vitest run --coverage",
    "test:unused": "yarn g:knip --workspace @voiceflow/universal-mock"
  },
  "peerDependencies": {
    "vitest": "^4"
  },
  "peerDependenciesMeta": {
    "vitest": {
      "optional": true
    }
  },
  "engines": {
    "node": "26"
  },
  "volta": {
    "extends": "../../package.json"
  }
}
