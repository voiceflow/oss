{
  "name": "@voiceflow/bidirectional-adapter",
  "version": "4.1.0",
  "description": "bi-directional adapter factory, used to decouple systems across shared data structures",
  "keywords": [
    "adapter",
    "data",
    "model",
    "voiceflow"
  ],
  "homepage": "https://github.com/voiceflow/oss/tree/master/libs/bidirectional-adapter#readme",
  "bugs": {
    "url": "https://github.com/voiceflow/oss/issues"
  },
  "license": "ISC",
  "author": "Tyler Han, Ben Teichman",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/voiceflow/oss.git"
  },
  "files": [
    "build"
  ],
  "type": "module",
  "exports": {
    ".": "./build/index.mjs"
  },
  "scripts": {
    "build": "yarn g:turbo run build:cmd --filter=@voiceflow/bidirectional-adapter...",
    "build:cmd": "yarn g:tsdown",
    "clean": "yarn g:rimraf build",
    "lint": "yarn g:run-p -c lint:oxlint lint:oxfmt",
    "lint:fix": "yarn g:run-p -c \"g:oxlint . --fix\" \"g:oxfmt .\"",
    "lint:oxfmt": "yarn g:oxfmt --check .",
    "lint:oxlint": "yarn g:oxlint .",
    "tdd": "yarn g:vitest",
    "test": "yarn g:run-p -c test:types test:unit test:cycles test:unused",
    "test:cycles": "yarn g:dpdm src/index.ts",
    "test:types": "yarn g:tsc --noEmit",
    "test:unit": "yarn g:vitest run --coverage",
    "test:unused": "yarn g:knip --workspace @voiceflow/bidirectional-adapter"
  },
  "engines": {
    "node": "26"
  },
  "volta": {
    "extends": "../../package.json"
  }
}
