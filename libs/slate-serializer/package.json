{
  "name": "@voiceflow/slate-serializer",
  "version": "4.0.0",
  "description": "Utilities for serializing slate data",
  "keywords": [
    "react",
    "slate",
    "voiceflow"
  ],
  "homepage": "https://github.com/voiceflow/oss/tree/master/libs/slate-serializer#readme",
  "bugs": {
    "url": "https://github.com/voiceflow/oss/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/voiceflow/oss.git"
  },
  "license": "ISC",
  "author": "Ben Teichman",
  "type": "module",
  "exports": {
    ".": "./build/index.mjs",
    "./jsx": "./build/jsx.mjs",
    "./markdown": "./build/markdown.mjs",
    "./text": "./build/text.mjs"
  },
  "files": [
    "build"
  ],
  "scripts": {
    "build": "yarn g:turbo run build:cmd --filter=@voiceflow/slate-serializer...",
    "build:cmd": "yarn g:tsdown",
    "clean": "yarn g:rimraf build",
    "lint": "yarn g:run-p -c lint:eslint lint:prettier",
    "lint:eslint": "yarn g:eslint",
    "lint:fix": "yarn g:run-p -c \"lint:eslint --fix\" \"lint:prettier --write\"",
    "lint:prettier": "yarn g:prettier --check",
    "tdd": "yarn g:vitest",
    "test": "yarn g:run-p -c test:types test:unit test:cycles test:unused",
    "test:cycles": "yarn g:dpdm src/index.ts",
    "test:types": "yarn g:tsc --noEmit",
    "test:unit": "yarn g:vitest run --coverage",
    "test:unused": "yarn g:knip --workspace @voiceflow/slate-serializer"
  },
  "devDependencies": {
    "@types/react": "18.2.4",
    "@voiceflow/dtos-interact": "2.36.0",
    "csstype": "3.2.3",
    "react": "18.2.0",
    "slate": "0.94.1",
    "zod": "3.22.4"
  },
  "peerDependencies": {
    "@voiceflow/dtos-interact": "^1.17.1 || ^2.0.0",
    "csstype": "^3.2.3",
    "react": "^17.0.2",
    "slate": "^0.72.3",
    "zod": "^3"
  },
  "engines": {
    "node": "26"
  },
  "volta": {
    "extends": "../../package.json"
  }
}
