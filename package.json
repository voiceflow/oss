{
  "name": "oss",
  "private": true,
  "workspaces": [
    "apps/*",
    "libs/*",
    "tests/*",
    "meta/*"
  ],
  "scripts": {
    "build": "turbo run build:cmd",
    "build:all": "yarn build",
    "clean": "turbo run clean && rimraf node_modules",
    "g:check-dependency-version-consistency": "cd $INIT_CWD && check-dependency-version-consistency .",
    "g:dpdm": "cd $INIT_CWD && dpdm --exit-code circular:1 --transform --no-warning --no-tree",
    "g:knip": "knip --config $PROJECT_CWD/knip.config.ts",
    "g:npm-package-json-lint": "cd $INIT_CWD && npmPkgJsonLint .",
    "g:oxfmt": "cd $INIT_CWD && oxfmt --config $PROJECT_CWD/oxfmt.config.mjs",
    "g:oxlint": "cd $INIT_CWD && oxlint --config $PROJECT_CWD/oxlint.config.mjs",
    "g:rimraf": "cd $INIT_CWD && rimraf",
    "g:run-p": "cd $INIT_CWD && run-p",
    "g:tsc": "cd $INIT_CWD && tsc",
    "g:tsdown": "cd $INIT_CWD && tsdown",
    "g:turbo": "cd $INIT_CWD && turbo",
    "g:vitest": "cd $INIT_CWD && vitest",
    "lint": "run-p -c lint:oxlint lint:oxfmt lint:packages",
    "lint:fix": "run-p -c \"g:oxlint . --fix\" \"g:oxfmt .\" \"g:check-dependency-version-consistency --fix\"",
    "lint:oxfmt": "yarn g:oxfmt --check .",
    "lint:oxlint": "yarn g:oxlint .",
    "lint:packages": "run-p -c \"g:npm-package-json-lint\" \"g:check-dependency-version-consistency\"",
    "lint:report": "run-p -c \"lint:oxlint --quiet\" lint:oxfmt lint:packages",
    "test": "turbo run test:types test:unit test:cycles test:unused",
    "test:cycles": "turbo run test:cycles",
    "test:dependencies": "turbo run test:cycles test:unused",
    "test:types": "turbo run test:types",
    "test:unit": "vitest run --coverage",
    "test:unused": "yarn g:knip"
  },
  "devDependencies": {
    "@commitlint/cli": "20.2.0",
    "@voiceflow/commitlint-config": "2.7.0",
    "@voiceflow/git-branch-check": "1.5.0",
    "@voiceflow/husky-config": "1.4.0",
    "@voiceflow/knip-config": "1.1.1",
    "@voiceflow/npm-package-json-lint-config": "1.5.0",
    "@voiceflow/oxfmt-config": "1.3.0",
    "@voiceflow/oxlint-config": "1.4.0",
    "@voiceflow/tsconfig": "1.18.0",
    "@voiceflow/tsdown-config": "1.3.0",
    "@voiceflow/vitest-config": "1.16.0",
    "check-dependency-version-consistency": "5.0.1",
    "dpdm": "4.3.0",
    "knip": "5.85.0",
    "lint-staged": "16.2.7",
    "npm-package-json-lint": "9.0.0",
    "npm-run-all": "4.1.5",
    "oxfmt": "0.78.0",
    "oxlint": "1.93.0",
    "rimraf": "6.1.2",
    "source-map-support": "0.5.21",
    "tsdown": "0.23.2",
    "turbo": "1.13.4",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  },
  "resolutions": {
    "browserslist": "4.28.1",
    "tsconfig-paths": "npm:@voiceflow/tsconfig-paths@1.1.3"
  },
  "lint-staged": {
    "*.{js,jsx,cjs,mjs,ts,tsx,cts,mts}": [
      "oxlint --config oxlint.config.mjs --fix --no-error-on-unmatched-pattern",
      "oxfmt --config oxfmt.config.mjs --no-error-on-unmatched-pattern"
    ],
    "*.{md,json,yml,yaml,toml}": "oxfmt --config oxfmt.config.mjs",
    "**/package.json": "npmPkgJsonLint"
  },
  "commitlint": {
    "extends": [
      "@voiceflow/commitlint-config"
    ]
  },
  "engines": {
    "node": "26"
  },
  "volta": {
    "node": "26.12.1",
    "yarn": "4.18.1"
  },
  "packageManager": "yarn@4.18.1"
}
